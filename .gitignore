# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local agent metadata
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Private pre-release evidence; never publish to this public repository.
/preview-images/
/PREPUBLICATION_AUDIT_*.md
/REMEDIATION_*.md
/ACCESS_VALIDATION_*.md
/UI_QA.md
/CALENDAR_VIEW_QA.md
/LOCAL_PREVIEW.md
